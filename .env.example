# H&H ERP Environment Variables Configuration Template

# Database Connection Settings
# Local SQLite fallback: sqlite:///happy_noether.db
# Production PostgreSQL/Supabase: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://username:password@host:6543/postgres

# Security & Session Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
COOKIE_SECURE=true

# Seed / Initial Owner Passcode (used to register the first owner account)
INITIAL_OWNER_PASSCODE=replace-with-a-strong-initial-passcode

# Controlled, read-only Google Sheets synchronization
# Share only the audited workbook(s) with the dedicated service account as Viewer.
# Production uses Vercel OIDC and Google Workload Identity Federation, so there
# is no long-lived private key. `service_account_key` remains supported for
# non-Vercel environments that explicitly permit keys.
GOOGLE_SHEETS_SYNC_ENABLED=false
GOOGLE_SHEETS_AUTH_MODE=vercel_oidc
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=hh-sync@your-project.iam.gserviceaccount.com
GOOGLE_SHEETS_PROJECT_ID=your-google-cloud-project-id
GOOGLE_SHEETS_PROJECT_NUMBER=123456789012
GOOGLE_SHEETS_WORKLOAD_IDENTITY_POOL_ID=hh-vercel
GOOGLE_SHEETS_WORKLOAD_IDENTITY_PROVIDER_ID=hh-hub
GOOGLE_SHEETS_ALLOWED_SPREADSHEET_IDS=approved-spreadsheet-id
